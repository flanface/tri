# copy to .env and fill in; never commit .env
# Server roles and channels are set in Discord with /setup, not here.
DISCORD_TOKEN=
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# The model: a fitted run loaded in-process (run dir or runs folder with LATEST)
TRI_RUN=runs

# Builds are read from the public builder page (deepwoken.co) or the dwt.sh API.
# deepwoken.co needs no key; dwt.sh reads need none either.

# dwt.sh (https://dwt.sh/docs/api). The key is needed to save tri's proposals
# as dwt.sh builds (/analyze dwt:True, /complete dwt:True).
DWT_API_KEY=
# folder for saved proposals: a folder id or name in the key's account root
# (created, unlisted, if missing; empty = the account root)
DWT_FOLDER=tri
# visibility of saved builds: public | unlisted | private
DWT_VISIBILITY=unlisted

CLAIM_TTL_MIN=120
STATE_PATH=bot_state.json
GUILD_CONFIG_STORE=auto
GUILD_CONFIG_PATH=guild_config.json
SYNC_MODE=guild
# 1 = read replies to review sheets without ping on reply (enable the Message Content
# intent for the bot in the Discord Developer Portal first)
TRI_MESSAGE_CONTENT=0
# 0 = plain code blocks instead of coloured (ansi) embed text
TRI_COLOR=1
# hours between checks of pocamind/data for new or changed talents and mantras (0 = off;
# /model sync still works). New items enter unrated, without a refit.
GAMEDATA_SYNC_HOURS=12
GAMEDATA_REF=main
GITHUB_TOKEN=          # optional; raises the GitHub API limit for the sync check
# user-installed app (/analyze, /complete, /plot anywhere, without inviting the bot):
# anyone | reviewers (holds a reviewer role in a tri server) | off. Enable "User Install" in the
# Developer Portal (Installation) first.
USER_APP=anyone
# delete a pool row once its review is stored (0: keep rows; they are never served again)
POOL_POP=1
# bot plot colours: dark (matches Discord) | light
PLOT_THEME=dark
# Buttons under /plot answers: turn, tilt, next axes, spin (GIF), interactive (HTML file). 0 to turn off.
PLOT_BUTTONS=1
# archetype placement image under /analyze and /complete (0 off)
PLACEMENT_INSET=1
# post new and retired facts to the review log every N days (0 off)
FACTS_DIGEST_DAYS=0

